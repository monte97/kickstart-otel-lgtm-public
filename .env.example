# Grafana admin credentials
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Retention (h = ore, d = giorni, w = settimane)
LOKI_RETENTION_PERIOD=744h
TEMPO_BLOCK_RETENTION=168h
MIMIR_BLOCKS_RETENTION=2160h

# Trace sampling
TRACE_SAMPLING_RATE=20
TRACE_LATENCY_THRESHOLD_MS=2000
TRACE_DECISION_WAIT=10s

# OpenSearch Trace Analytics (opt-in: make opensearch-up)
OPENSEARCH_VERSION=3.6.0          # usata sia da opensearch che da opensearch-dashboards (devono combaciare)
OPENSEARCH_DASHBOARDS_PORT=5601
OPENSEARCH_PORT=9200
OPENSEARCH_HEAP=512m
OPENSEARCH_SECURITY_DISABLED=true
DATAPREPPER_VERSION=2.15.1

# Porte host. I default sono i valori storici: senza questo file lo stack si
# comporta come sempre. Cambiali per far coesistere più istanze sulla stessa
# macchina (vedi anche: container_name è ancora fisso, quindi due istanze
# richiedono anche nomi container distinti).
GRAFANA_PORT=3000
LOKI_PORT=3100
TEMPO_PORT=3200
MIMIR_PORT=9009
ALERTMANAGER_PORT=9093
OTELCOL_GRPC_PORT=14317
OTELCOL_HTTP_PORT=14318
OTELCOL_HEALTH_PORT=13133
OTELCOL_ZPAGES_PORT=15679
